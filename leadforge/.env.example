# ─────────────────────────────────────────────────────────────
# LeadForge — every value is OPTIONAL. With none set it runs in
# local mode (embedded Postgres) + mock mode, zero accounts.
# ─────────────────────────────────────────────────────────────

# Database. Leave empty for embedded local Postgres (PGlite, stored in .data/).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=

# Security
APP_PASSWORD=                 # set to require a password (recommended when deployed)
APP_ENCRYPTION_KEY=           # long random string; encrypts API keys at rest. `openssl rand -base64 32`
CRON_SECRET=                  # protects /api/cron/tick (Vercel sends it automatically)

# Force mock mode regardless of the Settings toggle (demo deployments)
MOCK_MODE=

# LLM keys (can also be entered in Settings → API keys, stored encrypted)
GEMINI_API_KEY=               # https://aistudio.google.com/apikey  (free, no card)
GROQ_API_KEY=                 # https://console.groq.com/keys       (free)
OPENROUTER_API_KEY=           # https://openrouter.ai/keys          (free models)
OLLAMA_URL=                   # e.g. http://localhost:11434 (local, unlimited)

# Web search for discovery + people (pick any; all optional)
GOOGLE_CSE_KEY=               # 100 queries/day free (also set CX id in Settings)
BRAVE_API_KEY=                # free plan; sign-up may ask for a card
# SearXNG URL is set in Settings → Data sources

# Google Places — OPTIONAL, billing account required. Off by default.
GOOGLE_PLACES_KEY=

# Gmail (optional; read-only replies + optional drafts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage for brochures (optional; create a public bucket named "brochures")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# /legal page placeholders
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_EMAIL=

# Tuning
AUTO_MIGRATE=true             # apply migrations on first request
SEED_DEMO=true                # seed demo products/leads into an empty database
